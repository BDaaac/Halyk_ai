# Путь к набору данных. На приватном прогоне замените только этот каталог.
DATA_DIR=agentic-bank-public
WORKSPACE_DIR=workspace

# Имена моделей для будущих LLM-стадий.
EXTRACT_MODEL=
SELECT_MODEL=
VERIFY_MODEL=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=3
SELECT_MODE=scenario
EXTRACT_INPUT_USD_PER_MTOK=1
EXTRACT_OUTPUT_USD_PER_MTOK=5
SELECT_INPUT_USD_PER_MTOK=1
SELECT_OUTPUT_USD_PER_MTOK=5
