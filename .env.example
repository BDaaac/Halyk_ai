# Путь к набору данных организаторов. Для приватного прогона подмените
# на путь к их архиву.
DATA_DIR=agentic-bank-public
WORKSPACE_DIR=workspace

# Ключ Anthropic. Обязателен для стадий 2 (per-page vision), 6 (extract), 7 (select).
ANTHROPIC_API_KEY=

# Обязательные верхнеуровневые поля submission.json (CASE §3).
# Пустые строки — гарантированный отказ по формату. Впишите свои значения
# перед первым `main.py run` — stage 0 подставит их в submission автоматически.
TEAM_NAME=
CONTACT_EMAIL=
# Значение поля "model" в submission. По умолчанию используется SELECT_MODEL.
SUBMISSION_MODEL=claude-sonnet-5

# Мультимодальная модель для стадии 2 (per-page vision) и стадии 7 (select).
# Sonnet выбран, потому что Haiku на этих задачах даёт нестабильную структуру
# ответа — замер подтверждён на публичном сете. Балл 0.8167 и стоимость
# $0.296 на стадии 7 из README получены именно на этом ID.
SELECT_MODEL=claude-sonnet-5

# Модель стадии 6 (extract). Haiku её тянет.
EXTRACT_MODEL=claude-haiku-4-5-20251001

# Верификатор для low-confidence ячеек. Пока не вызывается — оставлен как placeholder.
VERIFY_MODEL=claude-haiku-4-5-20251001

# Сеть.
LLM_TIMEOUT_SECONDS=60
# LLM_MAX_CONCURRENCY читается конфигом, но клиент синхронный (urllib) — 24
# вызова идут последовательно, всё укладывается в ~3.5 минуты для 12 сценариев,
# rate-limit 429 не наблюдался. Значение оставлено на будущее.
LLM_MAX_CONCURRENCY=1
SELECT_MODE=scenario

# Прайсинг для расчёта стоимости прогона. Обновите при смене моделей.
# Значения соответствуют опубликованным ценам моделей выше — Haiku 4.5
# ($1 / $5 за MTok) и Sonnet 5 ($2 / $10 за MTok). Проверка: цена стадии 7
# в README ($0.296) = (130 226 * 2 + 3 553 * 10) / 1e6 = 0.295982.
EXTRACT_INPUT_USD_PER_MTOK=1
EXTRACT_OUTPUT_USD_PER_MTOK=5
SELECT_INPUT_USD_PER_MTOK=2
SELECT_OUTPUT_USD_PER_MTOK=10
